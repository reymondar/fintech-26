# Local: SQLite. Production: a persistent PostgreSQL connection (e.g. Neon).
DATABASE_URL=file:./data/payload.db
PAYLOAD_SECRET=
# Optional locally; mandatory for uploads on Vercel.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_SITE_URL=https://thestackhouse.io
# Enable the CMS as the blog source once content has been imported.
CMS_BLOG_ENABLED=false
# Required to expose the first-user signup in production; disable after creating the owner.
PAYLOAD_ALLOW_SETUP=false

# A scheduler calls /api/payload-jobs/run?queue=default with this bearer token.
CRON_SECRET=

# Keep CMS tables separate from any other app sharing this Neon database.
PAYLOAD_DB_SCHEMA=stackhouse_cms
